# Local development against the Firebase Emulator Suite: no cloud project, no
# real credentials. The emulators accept any values for these.
#
#   cp .env.emulator.example .env.local
#   npm run emulators   # terminal 1
#   npm run dev         # terminal 2
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-qso-log.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-qso-log
VITE_FIREBASE_STORAGE_BUCKET=demo-qso-log.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

VITE_USE_FIREBASE_EMULATORS=true
