#!/bin/sh
# Blocks a commit that bumps the package.json version without a changelog entry.

set -e

STAGED=$(git diff --cached --name-only)

echo "$STAGED" | grep -qx 'package.json' || exit 0

STAGED_VERSION=$(git show :package.json | node -e "console.log(JSON.parse(require('fs').readFileSync(0,'utf8')).version)")

HEAD_VERSION=$(
  git show HEAD:package.json 2>/dev/null |
    node -e "try{console.log(JSON.parse(require('fs').readFileSync(0,'utf8')).version)}catch{process.exit(1)}" ||
    echo ''
)

[ "$STAGED_VERSION" != "$HEAD_VERSION" ] || exit 0

echo "$STAGED" | grep -qx 'change-log.md' || {
  echo "pre-commit: package.json bumped to ${STAGED_VERSION} but change-log.md is not staged."
  echo "Add a ## [${STAGED_VERSION}] section at the top of change-log.md and git add it."
  exit 1
}
