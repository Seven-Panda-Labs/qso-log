# Firebase Web App config. Anything prefixed VITE_ is embedded in the client
# bundle and is public: never put a secret behind that prefix.
# Firebase console: Project settings > General > Your apps > SDK setup.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Point the app at the local Emulator Suite instead of the cloud project.
VITE_USE_FIREBASE_EMULATORS=false
